# Copy to .env and replace the development secret before use.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave blank to use SQLite, or set a PostgreSQL URL. URL-encode special
# characters in the username or password.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/LNDB
DATABASE_URL=

# Add exact browser origins only when needed. Flutter native apps do not use CORS.
CORS_ALLOWED_ORIGINS=
