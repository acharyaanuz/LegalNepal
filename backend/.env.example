# Copy to .env and replace the development secret before use.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave blank to use SQLite. Example:
# DATABASE_URL=postgresql://legalnepal:password@localhost:5432/legalnepal
DATABASE_URL=

# Add exact browser origins only when needed. Flutter native apps do not use CORS.
CORS_ALLOWED_ORIGINS=
